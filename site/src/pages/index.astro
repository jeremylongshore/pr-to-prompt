---
import BaseLayout from '../layouts/BaseLayout.astro';
import { marked } from 'marked';

const gistId = '5b2de7ba9baca1eaaa0a757b5b0c48db';
const res = await fetch(`https://api.github.com/gists/${gistId}`);
const gist = await res.json();
const content = Object.values(gist.files as Record<string, { content: string }>)[0].content;
const html = await marked(content);
---

<BaseLayout title="pr-to-spec — The Flight Envelope for Agentic Coding">
  <article class="prose" set:html={html} />
</BaseLayout>
